<Project>
    <!-- Surfaces the reference-scanning opt-out to the source generator. Scanning is on
         by default (the generator treats an absent value as enabled); set

             <ErgosfareSourceGeneratorScanReferences>false</ErgosfareSourceGeneratorScanReferences>

         in a project to restrict source-generated registration to types declared in that
         project. -->
    <ItemGroup>
        <CompilerVisibleProperty Include="ErgosfareSourceGeneratorScanReferences" />
    </ItemGroup>

    <!-- Marks (or unmarks) this project as an Ergosfare composition root — the compilation
         whose closure is complete, where the generator judges whole-closure dispatch
         reachability (ERGOSG005-008). Unset, executable output kinds are treated as roots
         and libraries are not; set

             <ErgosfareCompositionRoot>true</ErgosfareCompositionRoot>

         to force judgment in a library that composes the final pipeline (or false to
         silence it in an executable). -->
    <ItemGroup>
        <CompilerVisibleProperty Include="ErgosfareCompositionRoot" />
    </ItemGroup>

    <!-- Opt-in compile-time handler trim: in a composition root with complete dispatch
         manifests, handlers no dispatch site can reach are excluded from generated
         registration (reported as ERGOSG008) so the linker can drop them. Set

             <ErgosfareTrimUnusedHandlers>true</ErgosfareTrimUnusedHandlers>

         to enable. -->
    <ItemGroup>
        <CompilerVisibleProperty Include="ErgosfareTrimUnusedHandlers" />
    </ItemGroup>

    <!-- Force-opts an assembly back into cross-assembly discovery even though its name
         matches Ergosfare's reserved "Stella.Ergosfare" prefix (which is otherwise skipped,
         because the library's own contract interfaces inherit the module markers). Set

             <ErgosfareSourceGeneratorForceScanReferences>true</ErgosfareSourceGeneratorForceScanReferences>

         in a project you deliberately named under that prefix. The property is baked into
         the assembly as [assembly: AssemblyMetadata(...)] so the generator reads the opt-in
         per referenced assembly — only assemblies that set it are scanned, so the library's
         own contracts are never registered. -->
    <ItemGroup Condition="'$(ErgosfareSourceGeneratorForceScanReferences)' == 'true'">
        <AssemblyMetadata Include="ErgosfareSourceGeneratorForceScanReferences" Value="true" />
    </ItemGroup>
</Project>
