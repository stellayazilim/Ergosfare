<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Stella.Ergosfare.Core.Abstractions</PackageId>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- UseDefaultResultAdapter is the one door to the fallback carrier: the call the
             generator reads, and so the only one whose adapter reaches a generated table. -->
        <InternalsVisibleTo Include="Stella.Ergosfare.Core.Extensions.MicrosoftDependencyInjection" />
        <!-- The binding and carrier suites live with the core's tests rather than in a
             project of their own. -->
        <InternalsVisibleTo Include="Stella.Ergosfare.Core.Test" />
        <!-- The dispatch ends a stream message it stopped serving; that call is the pipeline's
             and nobody else's. -->
        <InternalsVisibleTo Include="Stella.Ergosfare.Core" />
    </ItemGroup>

</Project>
