<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- e2e runs on the .NET 10 LTS runtime only; a single TFM keeps the harness
             simple. The singular TargetFramework overrides the repo-root multi-TFM. -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

</Project>
