<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- The e2e app doubles as the NativeAOT gate: it is the only place where the
             library's generated registration, its interceptors and its staged plans are
             published ahead of time, in a real multi-assembly application. Trim and AOT
             analyzer findings therefore fail this build rather than scroll past. -->
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Stella.MinimalApi" Version="2.0.1" />
        <!-- Endpoint discovery at compile time instead of by scanning the assembly: the
             generator emits the registrations into GeneratedEndpointDiscovery, so no
             endpoint depends on reflection surviving the trimmer. -->
        <PackageReference Include="Stella.MinimalApi.SourceGenerator" Version="2.0.1"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Stella.Ergosfare.E2E.Contracts\Stella.Ergosfare.E2E.Contracts.csproj" />
        <ProjectReference Include="..\Stella.Ergosfare.E2E.Infrastructure\Stella.Ergosfare.E2E.Infrastructure.csproj" />
        <ProjectReference Include="..\Stella.Ergosfare.E2E.UseCases\Stella.Ergosfare.E2E.UseCases.csproj" />

        <!-- The whole Ergosfare runtime + DI extensions, wired from local src (not NuGet)
             so e2e exercises the code on this branch. -->
        <ProjectReference Include="..\..\..\src\Stella.Ergosfare\Stella.Ergosfare.csproj" />
        <!-- The source generator as an analyzer: it emits RegisterGenerated() into this
             compilation, discovering handlers in the referenced UseCases assembly. -->
        <ProjectReference Include="..\..\..\src\Stella.Ergosfare.SourceGenerator\Stella.Ergosfare.SourceGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!-- The example plugin. Installing one is a single reference: this app's generator
             reads its [PipelineInvokable] methods out of the assembly and bakes the calls
             into this app's plans. -->
        <ProjectReference Include="..\..\TimingPlugin\TimingPlugin.csproj" />
    </ItemGroup>

</Project>
