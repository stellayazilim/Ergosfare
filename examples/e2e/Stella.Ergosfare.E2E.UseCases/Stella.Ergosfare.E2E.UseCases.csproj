<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Installing an experimental surface is deliberate. -->
        <NoWarn>$(NoWarn);ERGOEXP002</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Stella.Ergosfare.E2E.Contracts\Stella.Ergosfare.E2E.Contracts.csproj" />
        <ProjectReference Include="..\Stella.Ergosfare.E2E.Domain\Stella.Ergosfare.E2E.Domain.csproj" />
        <ProjectReference Include="..\Stella.Ergosfare.E2E.Infrastructure\Stella.Ergosfare.E2E.Infrastructure.csproj" />
        <!-- Handlers and interceptors live here, one assembly away from the Api where the
             generator runs â€” this is the cross-assembly discovery path under test. -->
        <ProjectReference Include="..\..\..\src\Stella.Ergosfare.Commands.Abstractions\Stella.Ergosfare.Commands.Abstractions.csproj" />
        <ProjectReference Include="..\..\..\src\Stella.Ergosfare.Queries.Abstractions\Stella.Ergosfare.Queries.Abstractions.csproj" />
        <ProjectReference Include="..\..\..\src\Stella.Ergosfare.Events.Abstractions\Stella.Ergosfare.Events.Abstractions.csproj" />
        <ProjectReference Include="..\..\..\src\Stella.Ergosfare.Core.Abstractions\Stella.Ergosfare.Core.Abstractions.csproj" />

        <!-- The application layer composes the pipeline, so the DI extensions and the whole
             runtime live here rather than in the host. -->
        <ProjectReference Include="..\..\..\src\Stella.Ergosfare\Stella.Ergosfare.csproj" />

        <!-- The generator runs in this compilation: RegisterGenerated() is emitted here,
             beside the AddErgosfare call that uses it. -->
        <ProjectReference Include="..\..\..\src\Stella.Ergosfare.SourceGenerator\Stella.Ergosfare.SourceGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />

        <!-- The example plugin is installed by the composition, so it is referenced here. -->
        <ProjectReference Include="..\..\TimingPlugin\TimingPlugin.csproj" />
    </ItemGroup>

</Project>
